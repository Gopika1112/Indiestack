# IndieStack Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=indiestack
POSTGRES_PASSWORD=change_me_in_production_use_strong_password
POSTGRES_DB=indiestack
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# ============================================
# JWT Secrets (Generate strong random values)
# Use: openssl rand -base64 32
# ============================================
JWT_SECRET=change_me_use_random_32_byte_string_min
JWT_REFRESH_SECRET=change_me_use_different_random_32_byte_string

# ============================================
# Admin Credentials (Development Only)
# ============================================
ADMIN_EMAIL=admin@indiestack.local
ADMIN_PASSWORD=change_me_in_production

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis:6379

# ============================================
# NATS Configuration
# ============================================
NATS_URL=nats://nats:4222

# ============================================
# MeiliSearch Configuration
# ============================================
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change_me_use_random_string

# ============================================
# Payment Gateway (Razorpay)
# ============================================
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# Cloudflare R2 (Object Storage)
# ============================================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=indiestack-uploads

# ============================================
# Application Settings
# ============================================
APP_ENV=production
SERVER_PORT=3001
LOG_LEVEL=info
