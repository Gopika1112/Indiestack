{
    auto_https off
}

:80 {
    # Health check endpoint
    handle /health {
        respond "OK" 200
    }

    # API routes -> Go backend
    handle /api/v1/* {
        reverse_proxy go-api:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # RSS, sitemap, and robots.txt routes are disabled because no backend handlers exist yet.
    # Uncomment and route to go-api:3001 once handlers are implemented (Module 2/3).
    # handle /rss/* {
    #     reverse_proxy go-api:3001
    # }

    # handle /sitemap.xml {
    #     reverse_proxy go-api:3001
    # }

    # handle /robots.txt {
    #     reverse_proxy go-api:3001
    # }

    # Everything else -> Next.js
    handle {
        reverse_proxy nextjs:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Enable compression
    encode gzip

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        remove Server
    }

    # Logging
    log {
        output stdout
    }
}
