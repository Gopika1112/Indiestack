{
    auto_https off
}

:80 {
    # Health check endpoint
    handle /health {
        respond "OK" 200
    }

    # API routes -> Go backend
    handle /api/v1/* {
        reverse_proxy go-api:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

        # RSS routes -> Go backend (Next.js has no RSS handler)
    # Match both bare /rss and /rss/* (e.g. /rss/{username})
    handle /rss {
        reverse_proxy go-api:3001
    }

    handle /rss/* {
        reverse_proxy go-api:3001
    }

    # sitemap.xml and robots.txt -> Next.js (app/sitemap.ts and app/robots.ts are
    # the single source of truth; previously these went to the Go backend, which
    # shadowed the Next.js-native versions and caused duplication)
    handle /sitemap.xml {
        reverse_proxy nextjs:3000
    }

    handle /robots.txt {
        reverse_proxy nextjs:3000
    }

    # Serve uploaded files
    handle /uploads/* {
        reverse_proxy go-api:3001
    }

    # Everything else -> Next.js
    handle {
        reverse_proxy nextjs:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Enable compression
    encode gzip

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        remove Server
    }

    # Logging
    log {
        output stdout
    }
}
